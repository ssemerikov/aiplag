	author = {Bevendorff, Janek and Dementieva, Daryna and Fröbe, Maik and Gipp, Bela and Greiner-Petter, André and Karlgren, Jussi and Mayerl, Maximilian and Nakov, Preslav and Panchenko, Alexander and Potthast, Martin and Shelmanov, Artem and Stamatatos, Efstathios and Stein, Benno and Wang, Yuxia and Wiegmann, Matti and Zangerle, Eva},
